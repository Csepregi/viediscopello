{
  "name": "viadiscopellotickets",
  "private": true,
  "author": "https://github.com/dev-xo",
  "sideEffects": false,
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "build": "remix build",
    "dev": "remix dev",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/index.js",
    "test:e2e:dev": "playwright test",
    "test:e2e:install": "pnpm exec playwright install chromium --with-deps",
    "pretest:e2e:run": "pnpm build",
    "test:e2e:run": "cross-env CI=true playwright test",
    "typecheck": "tsc",
    "validate": "pnpm lint && pnpm typecheck && pnpm test:e2e:run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@prisma/client": "^6.19.2",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@stitches/react": "^1.2.8",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.8.0",
    "autoprefixer": "^10.4.24",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "intl-parse-accept-language": "^1.0.0",
    "isbot": "^5.1.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "remix-utils": "^9.0.1",
    "stripe": "^20.3.1",
    "tiny-invariant": "^1.3.3",
    "validate-npm-package-name": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@remix-run/dev": "^2.17.4",
    "@remix-run/eslint-config": "^2.17.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^6.19.2",
    "remix-flat-routes": "^0.8.5",
    "stripe-event-types": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "ts-node --require tsconfig-paths/register prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
